NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DESK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
TRANSLATOR_MODEL=openai/gpt-oss-20b
EDITOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.plain-news.ch

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GITHUB_TOKEN=
GITHUB_GIST_COMMENTS_ID=

# Newsroom cadence (hourly; 0 means no numeric article cap)
MAX_STORIES_PER_RUN=0
MAX_PER_CATEGORY=0
MIN_PER_CATEGORY_PER_CYCLE=1
TARGET_PER_CATEGORY_PER_CYCLE=0
EVENT_CONCURRENCY=4
TRANSLATION_CONCURRENCY=8
RECENT_WINDOW_HOURS=1
MAX_AGE_HOURS=8
MAX_ARTICLES_PER_DAY=0
RUN_BUDGET_MINUTES=110
DESK_MAX_BATCHES=10

# --- Live tickers (bots/live.mjs, every 10 min) ------------------------------
# One ongoing event (election night, war, disaster) gets a chronological stream
# of updates. Every update needs at least 2 independent outlets; the gate is
# enforced in code, not by the model.
LIVE_AUTO_CREATE=1
LIVE_WINDOW_HOURS=6
LIVE_PER_FEED=25
LIVE_MIN_SOURCES=2
LIVE_MIN_OUTLETS_CREATE=4
LIVE_MAX_NEW_TICKERS=1
LIVE_MAX_UPDATES_PER_RUN=3
LIVE_ARTICLE_REFRESH_MIN=25
LIVE_IDLE_END_HOURS=12
LIVE_TRANSLATE_CONCURRENCY=4
# "0" = global kill switch for the dismissible banner above the site header
NEXT_PUBLIC_LIVE_BANNER=1

# --- Long reads (bots/longform.mjs, 3x daily) --------------------------------
# 2-3 long, explanatory pieces per run. Each needs several outlets and passes
# an editor pass before it is published; nothing is invented to fill length.
LONGFORM_PER_RUN=3
LONGFORM_LOOKBACK_HOURS=48
LONGFORM_PER_FEED=30
LONGFORM_MIN_SOURCES=2
LONGFORM_MIN_WORDS=950
LONGFORM_MAX_READS=5
LONGFORM_TRANSLATE_CONCURRENCY=3
LONGFORM_LOCALES=en,de,fr,es,it,pt
# "1" = plan and write, publish nothing (local testing)
LONGFORM_DRY_RUN=0

# --- Investigative desk (bots/investigate.mjs, daily) ------------------------
# The desk works like a reporter: it searches, opens documents (HTML and PDF),
# files claims with the source that carries them, writes to press offices and
# reads the replies. Sending needs a human "approved" in /admin/investigations.
# "1" = research and write, publish/mirror/send nothing
INVESTIGATE_DRY_RUN=0
# Steps the agent may take per dossier and run
INVESTIGATE_AGENT_STEPS=12
# Publish gates: outlets, official/primary documents, supported claims, words
INVESTIGATE_MIN_SOURCES=8
INVESTIGATE_MIN_PRIMARY=2
INVESTIGATE_MIN_CLAIMS=6
INVESTIGATE_MIN_WORDS=2500
INVESTIGATE_MINUTES=55
# Own mailbox: replies to desk+<slug>@<domain> land in /api/inbound/email
DESK_EMAIL_DOMAIN=plain-news.ch
# Shared secret the mail provider adds as x-inbound-secret; empty = endpoint closed
INBOUND_SECRET=
# Fallback when no domain is configured
EDITORIAL_EMAIL=
# The desk reads its own mailbox over IMAP; no provider webhook in between.
# Host is the mail server of the domain (Dovecot over TLS on 993).
IMAP_HOST=mail.securemail.pro
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Visitor log (optional) -------------------------------------------------
# Admin page: https://www.plain-news.ch/de/admin/visits (HTTP Basic auth)
VISITS_ADMIN_USER=
VISITS_ADMIN_PASS=
# Salt for the IP hash. Any random string; keep it secret and stable.
VISIT_HASH_SALT=
# "1" = store the full IP in visits.ip (personal data, see privacy policy)
VISITS_FULL_IP=0
# "0" = kill switch, stops writing rows
VISITS_ENABLED=1
